# ═══════════════════════════════════════════════════════════
# Hugging Face — autenticação para download de modelos
# Obtenha em: https://huggingface.co/settings/tokens
# Nível mínimo: "Read" (permite download de modelos públicos)
# Sem esta chave: rate-limiting anônimo do HuggingFace Hub
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════
# OpenAI — apenas para Notebooks 02, 04 e 05
# Obtenha em: https://platform.openai.com/api-keys
# Sem esta chave: o sistema usa apenas o classificador
# fine-tuned + GPT4All local (nenhum custo)
OPENAI_API_KEY=sk-xxx...xxxx

# ═══════════════════════════════════════════════════════════
# DeepSeek — alternativa ao OpenAI para Notebooks 02, 04 e 05
# Obtenha em: https://platform.deepseek.com/api-keys
# Modelo padrao: deepseek-chat (flash = mais rapido + barato)
# Uso: substitui OpenAI como provider padrao no LLMProvider
DEEPSEEK_API_KEY=sk-xxx...xxxx
DEEPSEEK_MODEL=deepseek-chat

# ═══════════════════════════════════════════════════════════
# GPT4All — modelo local (baixado automaticamente na 1ª execução)
# Não requer chave. Modelo padrão: Phi-3-mini-4k-instruct (~2 GB)
# Configurável em: scripts/classifier.py → GPT4ALL_MODEL
# GPT4ALL_FETCH_OVERRIDE=True  # força re-download
# ═══════════════════════════════════════════════════════════
